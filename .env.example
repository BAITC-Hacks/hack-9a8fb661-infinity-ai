# LLM: true = сохранённые ответы, ключ не нужен (режим для проверки экспертами)
USE_MOCK_LLM=true
# Провайдер: auto | vllm | openai | mock. auto = vllm (если LLM_BASE_URL) -> openai -> mock,
# при сбое основного агент переходит к следующему
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
LLM_MAX_TOKENS=600

# Погода: true = только кеш data/cache, без сети
WEATHER_OFFLINE=false

# Смещение времени в исходных CSV относительно UTC (часы)
SOURCE_UTC_OFFSET=5

# Хранилище: clickhouse (docker compose up clickhouse) | sqlite (файл data/app.db, без сервера)
DB_BACKEND=sqlite
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=wind
CLICKHOUSE_PASSWORD=wind
CLICKHOUSE_DB=wind

# LLM на своём GPU (vLLM на NVIDIA Brev, OpenAI-совместимый API), напр. http://localhost:8001/v1
LLM_BASE_URL=
VLLM_MODEL=qwen

# Вход в интерфейс. Пустой APP_PASSWORD — без входа. Для проверки: логин/пароль ниже
APP_LOGIN=expert
APP_PASSWORD=infinity-demo
APP_SECRET=
